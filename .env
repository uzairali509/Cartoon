# Cartoon Universe - Environment Configuration
# Copy this file to .env and add your actual API keys

# TMDB (The Movie Database) API Key
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=8d2b5a973366947b6ec1793a6a35efcf

# Optional: Custom cache directory (default: storage/cache/api)
API_CACHE_DIR=/path/to/cache

# Optional: Video provider configuration (when available)
VIDEO_PROVIDER_ENABLED=false
VIDEO_PROVIDER_BASE_URL=https://your-video-provider.com/api